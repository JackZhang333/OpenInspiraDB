{
  "name": "inspiradb",
  "version": "0.2.0",
  "description": "InspiraDB desktop app (V1-A)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:build": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:dmg": "npm run build && electron-builder --mac dmg",
    "dist:dmg:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "dist:mas": "npm run build && electron-builder --mac mas",
    "dist:mas-dev": "npm run build && electron-builder --mac mas-dev",
    "icon:mac": "node scripts/build-mac-icon.mjs",
    "start": "node src/cli/demo.js",
    "test": "node --test"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.inspiradb.desktop",
    "productName": "InspiraDB",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "CFBundleDisplayName": "InspiraDB",
        "CFBundleName": "InspiraDB",
        "NSHumanReadableCopyright": "Copyright © 2026 InspiraDB. All rights reserved.",
        "NSSupportsAutomaticGraphicsSwitching": true
      },
      "target": [
        "zip"
      ]
    },
    "dmg": {
      "sign": false
    },
    "mas": {
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "type": "distribution"
    },
    "masDev": {
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns",
      "type": "development"
    }
  }
}
