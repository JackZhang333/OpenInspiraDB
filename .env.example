# Zhipu AI Configuration
# Get your API key from: https://open.bigmodel.cn/usercenter/apikeys
# This is required for AI-powered image analysis and tagging
ZHIPU_API_KEY=your_api_key_here

# Optional: API base URL (defaults to Zhipu AI official endpoint)
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Optional: Model configuration
ZHIPU_VISION_MODEL=GLM-4V-Plus-0111
ZHIPU_REASONING_MODEL=GLM-4-Flash
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=256
